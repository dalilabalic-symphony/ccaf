    "agent-sdk": "tsx src/part1/4-agent-sdk.ts",
    "context": "tsx src/part2/5-subagent-context.ts",
    "fanout": "tsx src/part2/6-coordinator-fanout.ts",
    "routing": "tsx src/part2/7-dynamic-routing.ts",
    "refine": "tsx src/part2/8-refinement-loop.ts",
    "fork": "tsx src/part2/9-fork-session.ts",
    "gate": "tsx src/part3/10-prerequisite-gate.ts",
    "decompose": "tsx src/part3/11-parallel-investigation.ts",
