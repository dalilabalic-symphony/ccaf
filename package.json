{
  "name": "claude-agent-loop-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript examples of the Claude agent loop (Messages API, manual tool-use loop, Tool Runner, Agent SDK) and of coordinator/subagent orchestration with the Agent SDK",
